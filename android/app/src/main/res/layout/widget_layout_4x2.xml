<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 Placar do Jogo widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- LOCKED IN wordmark -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCKED IN"
        android:textSize="8sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textColor="#F5F5F5"
        android:alpha="0.7" />

    <!-- Main content row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <!-- Left: count (32%) or check icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="32"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_4x2_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03"
                android:textSize="52sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="#D84315"
                android:includeFontPadding="false" />

            <!-- BUG-001: sem android:src — bitmap setado via setImageViewBitmap() no Java -->
            <ImageView
                android:id="@+id/widget_4x2_check"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_4x2_label_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMANESCENTES"
                android:textSize="7sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="#EBF5F5F5"
                android:maxLines="2" />
        </LinearLayout>

        <!-- Half-court divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2A2A2A"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <!-- Right: pending habit list or message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="68"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="8dp">

            <!-- Habit row 1 -->
            <LinearLayout
                android:id="@+id/widget_4x2_habit_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/widget_ring"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_4x2_habit1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="#F5F5F5"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Habit row 2 -->
            <LinearLayout
                android:id="@+id/widget_4x2_habit_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/widget_ring"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_4x2_habit2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="#F5F5F5"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Habit row 3 -->
            <LinearLayout
                android:id="@+id/widget_4x2_habit_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/widget_ring"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_4x2_habit3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="#F5F5F5"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Mensagem alternativa: game over ou sem hábitos (BUG-008) -->
            <TextView
                android:id="@+id/widget_4x2_gameover_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nada na fila.\nDia vencido."
                android:textSize="9sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="#8CF5F5F5"
                android:maxLines="2"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- BUG-002: style estático, sem referência de tema -->
    <ProgressBar
        android:id="@+id/widget_4x2_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_drawable"
        android:layout_marginTop="4dp" />

</LinearLayout>
